<h2 class="text-center mb-4">📝 Notes</h2>

<!-- NEW NOTE BUTTON -->
<div class="text-center mb-3 mb-10">
  <%= link_to "New Note",
        new_note_path,
        data: { turbo_frame: "new_note_form" },
        class: "btn btn-primary px-4" %>
</div>

<%= turbo_frame_tag "new_note_form" do %>
  <%= render "placeholder" %>
<% end %>

<!-- NOTES LIST -->
<div id="notes">
  <% if @notes.any? %>
    <%= render @notes %>
  <% else %>
    <div class="text-center text-muted">
      No notes yet. Create your first one!
    </div>
  <% end %>
</div>