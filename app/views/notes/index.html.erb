<div class="container mt-4">
  <h2 class="text-center mb-4">📝 Notes</h2>

  <!-- NEW NOTE BUTTON -->
  <div class="text-center mb-3">
    <%= link_to "New Note",
          new_note_path,
          data: { turbo_frame: "new_note_form" },
          class: "btn btn-primary px-4" %>
  </div>

  <%= turbo_frame_tag "new_note_form" do %>
    <% if @notes.none? %>
      <%= render "placeholder" %>
    <% end %>
  <% end %>

  <!-- NOTES LIST -->
  <%= turbo_frame_tag "notes", class: "mt-3" do %>
    <%= render @notes %>
  <% end %>
</div>