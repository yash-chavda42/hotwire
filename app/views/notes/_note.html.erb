<turbo-frame id="<%= dom_id(note) %>">
  <div class="note-form-card note-item">
    
    <div class="note-content">
      <h5 class="note-title">
        <%= link_to note.title, note_path(note), data: { turbo_frame: "_top" } %>
      </h5>

      <p class="note-text"><%= note.content %></p>
    </div>

    <div class="note-actions">
      <%= link_to edit_note_path(note),
            data: { turbo_frame: dom_id(note) },
            class: "icon-btn edit-btn" do%>
              <i class="fas fa-edit"></i>
            <% end %>

      <%= link_to note_path(note),
            data: { turbo_method: :delete },
            class: "icon-btn delete-btn" do %>
              <i class="fas fa-trash"></i>
            <% end %>
    </div>

  </div>
</turbo-frame>