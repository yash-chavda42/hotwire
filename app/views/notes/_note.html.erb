<turbo-frame id="<%= dom_id(note) %>">
  <div class="card shadow-sm mb-3">
    <div class="card-body">
      <h5><%= note.title %></h5>
      <p><%= note.content %></p>

      <%= link_to "Edit",
            edit_note_path(note),
            data: { turbo_frame: dom_id(note) },
            class: "btn btn-sm btn-warning" %>

      <%= link_to "Delete",
          note_path(note),
          data: {
            turbo_method: :delete
          },
          class: "btn btn-sm btn-danger" %>
    </div>
  </div>
</turbo-frame>