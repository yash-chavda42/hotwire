<div class="note-form-card">
  <%= form_with(model: note, class: "note-form") do |f| %>

    <div class="error-container">
      <% if note.errors.any? %>
        <div class="error-message">
          <%= note.errors.full_messages.to_sentence.capitalize %>
        </div>
      <% end %>
    </div>

    <div class="form-row">
      <%= f.text_field :title, class: "input title", placeholder: "Title" %>
      <%= f.text_field :content, class: "input content", placeholder: "Content" %>

      <!-- Submit Button -->
      <%= button_tag type: "submit", class: "icon-btn submit-btn" do %>
        <i class="fa-solid fa-arrow-right"></i>
      <% end %>

      <!-- Cancel Button -->
      <%= link_to notes_path, class: "icon-btn cancel-btn" do %>
        <i class="fa-solid fa-xmark"></i>
      <% end %>
    </div>

  <% end %>
</div>