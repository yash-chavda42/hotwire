<div class="auth-card">
  <h2 class="auth-title">Welcome Back 👋</h2>

  <%= form_with url: login_path, class: "auth-form" do %>

    <%= email_field_tag :email, nil,
          placeholder: "Email",
          class: "auth-input" %>

    <%= password_field_tag :password, nil,
          placeholder: "Password",
          class: "auth-input" %>

    <%= submit_tag "Log In", class: "auth-btn" %>

  <% end %>

  <p class="auth-footer">
    Don't have an account?
    <%= link_to "Sign Up", new_user_path, class: "auth-link" %>
  </p>
</div>